{
    "name": "team-mate-pro/contracts",
    "version": "1.3.1",
    "description": "A set of contracts in TMP company projects",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/serializer": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "TeamMatePro\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeamMatePro\\Contracts\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sebastian Twaróg",
            "email": "sebastian.twarog1989@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "team-mate-pro/make": "dev-main",
        "team-mate-pro/tests-bundle": "^1.22",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-phpunit": "*",
        "phpstan/phpstan-symfony": "^1.0",
        "phpstan/extension-installer": "*",
        "phpunit/phpunit": "^10.5",
        "symfony/console": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "scripts": {
        "phpunit": "APP_ENV=test ./vendor/bin/phpunit tests --testdox --colors=always",
        "tests:unit": "APP_ENV=test php bin/console tmp:tests --suite Unit --no-warmup --coverage 91",
        "tests:coverage": "APP_ENV=test ./vendor/bin/phpunit --testdox --colors=always --coverage-text",
        "phpcs": "php ./vendor/bin/phpcs --standard=phpcs.xml --exclude=Generic.Files.LineLength",
        "phpcs:fix": "php ./vendor/bin/phpcbf --standard=phpcs.xml --exclude=Generic.Files.LineLength",
        "phpstan": "php vendor/phpstan/phpstan/phpstan analyse --memory-limit=1G",
        "phpstan:baseline": "php ./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit 1G --generate-baseline"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
